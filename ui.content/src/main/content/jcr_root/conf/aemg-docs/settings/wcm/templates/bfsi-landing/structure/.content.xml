                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Project Evaluation &amp;amp; Selection&lt;/p>&#xd;&#xa;&lt;p>A dedicated Green Finance Committee will assess and approve projects based on their environmental benefits and alignment with green financing standards.&lt;/p>&#xd;&#xa;"
