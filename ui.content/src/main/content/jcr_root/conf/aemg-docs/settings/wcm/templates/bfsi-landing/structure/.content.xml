                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p class=&quot;table-heading&quot;>Find out more about our &lt;a href=&quot;#&quot;>Sustainable Financing&lt;/a>&lt;/p>&#xd;&#xa;&lt;div class=&quot;table&quot;>&lt;table class=&quot;tgroup&quot;>&#xd;&#xa;&lt;caption class=&quot; title&quot;>Advanced EV Comparison&lt;/caption>&#xd;&#xa;&lt;colgroup>&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;col class=&quot;colspec tcx-empty-element&quot; data-attr-rowheader=&quot;headers&quot; />&lt;/colgroup>&lt;thead class=&quot;thead&quot;>&lt;tr class=&quot;row&quot;>&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col1&quot;>Vehicle Type&lt;/th>&#xd;&#xa;&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col2&quot;>Battery Capacity (kWh)&lt;/th>&#xd;&#xa;&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col3&quot;>Range (miles)&lt;/th>&#xd;&#xa;&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col4&quot;>Charging Time (hours)&lt;/th>&#xd;&#xa;&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col5&quot;>CO₂ Emissions (g/km)&lt;/th>&#xd;&#xa;&lt;th class=&quot;entry&quot; data-attr-colname=&quot;col6&quot;>Cost per Charge ($)&lt;/th>&#xd;&#xa;&lt;/tr>&lt;/thead>&lt;tbody class=&quot;tbody&quot;>&lt;tr class=&quot;row&quot;>&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col1&quot;>Battery Electric Vehicle (BEV)&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col2&quot;>75&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col3&quot;>250&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col4&quot;>6&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col5&quot;>0&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col6&quot;>15&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr class=&quot;row&quot;>&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col1&quot;>Plug-in Hybrid Electric Vehicle (PHEV)&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col2&quot;>18&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col3&quot;>40&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col4&quot;>2.5&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col5&quot;>40&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col6&quot;>10&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr class=&quot;row&quot;>&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col1&quot;>Hybrid Electric Vehicle (HEV)&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col2&quot;>0&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col3&quot;>450+&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col4&quot;>n/a&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col5&quot;>90&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col6&quot;>8&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr class=&quot;row&quot;>&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col1&quot;>Electric Vehicle Group (BEV + PHEV)&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col2&quot;>93&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col3&quot;>290&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col4&quot;>8.5&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col5&quot;>40&lt;/td>&#xd;&#xa;&lt;td class=&quot;entry&quot; data-attr-colname=&quot;col6&quot;>12.5&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr class=&quot;row&q