                            text="&lt;div class=&quot;danger note hazardstatement&quot; data-attr-type=&quot;danger&quot;>&lt;span class=&quot;prefix-content&quot;>Danger: &lt;/span>&lt;ul class=&quot;ul messagepanel&quot;>&lt;li class=&quot;li typeofhazard&quot;>Rotating Blade&lt;/li>&lt;li class=&quot;li consequence&quot;>Risk of severe injury from moving parts in electric vehicle systems.&lt;/li>&lt;li class=&quot;li howtoavoid&quot;>Ensure all power sources are disconnected before performing maintenance or servicing.&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-14
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div class=&quot;warning note hazardstatement&quot; data-attr-type=&quot;warning&quot;>&lt;span class=&quot;prefix-content&quot;>Warning: &lt;/span>&lt;ul class=&quot;ul messagepanel&quot;>&lt;li class=&quot;li typeofhazard&quot;>Hot Surfaces&lt;/li>&lt;li class=&quot;li consequence&quot;>Touching heated parts of the battery or motor may cause burns.&lt;/li>&lt;li class=&quot;li howtoavoid&quot;>Always wear appropriate protective gear and allow components to cool before handling.&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-15
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div class=&quot;caution note hazardstatement&quot; data-attr-type=&quot;caution&quot;>&lt;span class=&quot;prefix-content&quot;>Caution: &lt;/span>&lt;ul class=&quot;ul messagepanel&quot;>&lt;li class=&quot;li typeofhazard&quot;>Lifting Hazard&lt;/li>&lt;li class=&quot;li consequence&quot;>Lifting heavy vehicle parts incorrectly may result in injury.&lt;/li>&lt;li class=&quot;li howtoavoid&quot;>Follow proper lifting techniques and safety guidelines.&lt;/li>&lt;/ul>&lt;/div>"
