                        replacementTokenField="text">
                        <text-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;luxury-experiences&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Luxury Experiences and Travel Perks&lt;/h2>&lt;div class=&quot;p&quot;>Enjoy exclusive benefits designed to elevate your experience with the FSI Premier Visa Signature Debit Card.&lt;/div>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;vip-hotel-access&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>VIP Access to Prestigious Hotels&lt;/h2>&lt;div class=&quot;p&quot;>Benefit from VIP guest status at over 900 prestigious properties worldwide, including:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Mandarin Oriental&lt;/li>&lt;li class=&quot;li&quot;>Conrad&lt;/li>&lt;li class=&quot;li&quot;>Fairmont&lt;/li>&lt;li class=&quot;li&quot;>Astoria&lt;/li>&lt;li class=&quot;li&quot;>And many more luxury brands.&lt;/li>&lt;/ul>&lt;div class=&quot;p&quot;>These benefits are available through the Visa Luxury Hotel Collection program.&lt;/div>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-3
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;airport-assistance&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Airport Assistance Limousine Transfers&lt;/h2>&lt;div class=&quot;p&quot;>Access exclusive discounts for:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Airport assistance&lt;/li>&lt;li class=&quot;li&quot;>Limousine transfers worldwide&lt;/li>&lt;/ul>&lt;div class=&quot;p&quot;>Enjoy seamless travel, wherever you are.&lt;/div>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-4
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;hotel-perks&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Additional Hotel Perks&lt;/h2>&lt;div class=&quot;p&quot;>Receive added benefits during your hotel stays, including:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Automatic room upgrades (subject to availability)&lt;/li>&lt;li class=&quot;li&quot;>Extended check-out times&lt;/li>&lt;li class=&quot;li&quot;>USD 25 food and beverage credit at select hotels&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-5
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;spending-power-security&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Increased Spending Power and Security Features&lt;/h2>&lt;div class=&quot;p&quot;>Enjoy increased spending flexibility and robust security measures with your FSI Premier Visa Signature Debit Card.&lt;/div>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-6
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;purchase-limits&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Higher Daily Purchase Limits&lt;/h2>&lt;div class=&quot;p&quot;>Benefit from higher daily limits on purchases:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>₹4 lakhs for ATM, POS, and online transactions&lt;/li>&lt;li class=&quot;li&quot;>₹2 lakhs for contactless payments&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-7
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;transaction-security&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Transaction Limits Security&lt;/h2>&lt;div class=&quot;p&quot;>Control your spending with enhanced security features:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Set transaction limits for you and your children’s cards&lt;/li>&lt;li class=&quot;li&quot;>Control permitted transaction types for added protection&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-8
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;insurance-coverage&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Comprehensive Insurance Coverage&lt;/h2>&lt;div class=&quot;p&quot;>Feel secure with maximum coverage of ₹5 lakhs, protecting you from:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Lost cards&lt;/li>&lt;li class=&quot;li&quot;>Card skimming&lt;/li>&lt;li class=&quot;li&quot;>Online fraud&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-9
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;dining-lifestyle&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Exclusive Dining and Lifestyle Benefits&lt;/h2>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-10
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;eazydiner-membership&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>EazyDiner Prime Membership&lt;/h2>&lt;div class=&quot;p&quot;>Receive a complimentary 3-month EazyDiner Prime Membership with the FSI Premier Visa Signature Debit Card, offering:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Up to 50% off at over 3,000 top-tier restaurants and bars across India and Dubai&lt;/li>&lt;li class=&quot;li&quot;>Exclusive dining experiences and discounts&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-11
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div id=&quot;visa-dine-save&quot; class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles title&quot; data-attr-outputclass=&quot;chapter_sub-titles&quot;>Visa Dine and Save Program&lt;/h2>&lt;div class=&quot;p&quot;>Enjoy additional dining discounts through the Visa Dine and Save program:&lt;/div>&lt;ul class=&quot;ul&quot;>&lt;li class=&quot;li&quot;>Up to 20% off at participating restaurants worldwide&lt;/li>&lt;/ul>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-12
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div class=&quot;footnote div&quot; data-attr-outputclass=&quot;footnote&quot;>&lt;div class=&quot;footnote-text p&quot; data-attr-outputclass=&quot;footnote-text&quot;>&lt;sup class=&quot;footnote-number ph sup&quot; data-attr-outputclass=&quot;footnote-number&quot;>1&lt;/sup> A GB (gigabyte) is equal to 1000 million bytes.&lt;/div>&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-13
