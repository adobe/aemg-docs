                        <text-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div class=&quot;section context&quot;>Once you have set up your vehicle maintenance system, you need to perform a series of tasks to ensure the vehicle is in top condition.&lt;/div>"
                            textIsRich="{Boolean}true"/>
                        <text-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;ol class=&quot;ol steps&quot;>&lt;li class=&quot;li step&quot;>&lt;span class=&quot;ph cmd display-inline&quot;>Inspect&lt;/span>&lt;div class=&quot;itemgroup info&quot;>&lt;span class=&quot;prefix-content&quot;>ADDITIONAL INFORMATION: &lt;/span>Inspect the vehicle's engine, tires, and fluid levels to ensure everything is functioning properly before starting the maintenance process.&lt;/div>&lt;/li>&lt;li class=&quot;li step&quot;>&lt;span class=&quot;ph cmd display-inline&quot;>Replace&lt;/span>&lt;div class=&quot;itemgroup info&quot;>&lt;span class=&quot;prefix-content&quot;>ADDITIONAL INFORMATION: &lt;/span>Replace old engine oil and filters, as well as worn-out brake pads, ensuring your vehicle's performance remains optimal.&lt;/div>&lt;/li>&lt;li class=&quot;li step&quot;>&lt;span class=&quot;ph cmd display-inline&quot;>Test&lt;/span>&lt;div class=&quot;itemgroup info&quot;>&lt;span class=&quot;prefix-content&quot;>ADDITIONAL INFORMATION: &lt;/span>Test the battery, lights, and electronic systems to confirm all components are in good working order, reducing the risk of failures.&lt;/div>&lt;/li>&lt;/ol>"
                            textIsRich="{Boolean}true"/>
                    </injected-container>
                </container1>
            </container_689917996>
