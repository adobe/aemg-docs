                        <text-30
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;div class=&quot;p&quot;>The power produced by the electrohydraulic dam was 10&lt;sup class=&quot;ph sup&quot;>10&lt;/sup> more than the older electric plant. The difference was H&lt;sub class=&quot;ph sub display-inline&quot;>2&lt;/sub>O.&lt;/div>"
