                            text="&lt;div class=&quot;section&quot;>&lt;h2 class=&quot;chapter_sub-titles chapter_sub-titles-landscape title&quot; data-attr-outputclass=&quot;chapter_sub-titles chapter_sub-titles-landscape&quot;>The all-new AI-Driven Quantum Processor&lt;/h2>&lt;div class=&quot;Images-content-section-container Images-content-section-container-landscape div&quot; data-attr-outputclass=&quot;Images-content-section-container Images-content-section-container-landscape&quot;>&lt;div class=&quot;content-figure-image content-figure-image-landscape div&quot; data-attr-outputclass=&quot;content-figure-image content-figure-image-landscape&quot;>&lt;figure id=&quot;fig_2&quot; class=&quot;fig&quot;>&lt;figcaption class=&quot;title&quot;>&lt;span class=&quot;prefix-content&quot;>Figure: &lt;/span>Full Speed Device with pull up resistor connected to D+&lt;/figcaption>&lt;div class=&quot;images-main-container images-main-container-landscape div&quot; data-attr-outputclass=&quot;images-main-container images-main-container-landscape&quot;>&lt;div class=&quot;image-num-container image-num-container-landscape div&quot; data-attr-outputclass=&quot;image-num-container image-num-container-landscape&quot;>&lt;div class=&quot;number number-landscape p&quot; data-attr-outputclass=&quot;number number-landscape&quot;>1&lt;/div>&lt;span class=&quot;placement-inline align-&quot;>&lt;img src=&quot;&quot; id=&quot;image_21&quot; class=&quot;resistor-image resistor-image-landscape image&quot; data-attr-outputclass=&quot;resistor-image resistor-image-landscape&quot; data-attr-placement=&quot;inline&quot;>&lt;/span>&lt;/div>&lt;div class=&quot;image-num-container image-num-container-landscape div&quot; data-attr-outputclass=&quot;image-num-container image-num-container-landscape&quot;>&lt;div class=&quot;number number-landscape p&quot; data-attr-outputclass=&quot;number number-landscape&quot;>2&lt;/div>&lt;span class=&quot;placement-inline align-&quot;>&lt;img src=&quot;&quot; id=&