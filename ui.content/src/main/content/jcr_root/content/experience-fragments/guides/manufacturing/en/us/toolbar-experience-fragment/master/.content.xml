<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[experience-fragments:variation/web]"
        cq:template="/conf/guides/templates/manufacturing/settings/wcm/templates/manufacturing-component-config-xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Site Wide Component Configurations"
        sling:resourceType="guides-components/components/guides-pages/manufacturing/manufacturing-guides-component-config-xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="guides-components/components/container"
            layout="responsiveGrid"/>
        <toolbar
            jcr:primaryType="nt:unstructured"
            sling:resourceType="guides-components/components/toolbar"
            embedAccessibility="true"
            embedBackToTop="false"
            embedFeedbackComponent="false"
            embedLanguageNavigation="true"
            embedCopyLinkComponent="true"
            embedNavigation="true"
            embedPdfExport="true"
            embedSocialShare="true"
            embedThemeSelector="true"
            searchIcon="/content/dam/guides/common-images/icons/search.svg"
            mobNavIcon="/content/dam/guides/common-images/icons/manufacturinng-navigation-icon.svg"
            tocIcon="/content/dam/guides/common-images/icons/manufacturinng-toc-icon.svg"
            latButton="/content/dam/guides/common-images/icons/manufacturing-kebab.svg"
            embedVersionSelector="true">
            <navigation
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/navigation2"
                collectAllPages="true"
                disableShadowing="false"
                filterSearchIcon="/content/dam/guides/common-images/icons/search.svg"
                arrowIcon="/content/dam/guides/common-images/icons/bx_chevron-right.svg"
                collapseIcon="/content/dam/guides/common-images/icons/collapse-icon.svg"
                navigationRoot="/content/guides/manufacturing"
                structureStart="4"/>
            <version-selector
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/version-selector"
                rootPagePath="/content/guides/manufacturing"
                skipLevels="3"/>
            <language-navigation
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/languagenavigation2"
                languageNavIcon="/content/dam/guides/common-images/icons/language.svg"
                navigationRoot="/content/guides/manufacturing"
                structureDepth="2"/>
            <social-share
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/social-share"
                shareIconPath="/content/dam/guides/common-images/icons/manufacturing-share.svg"
                social="[linkedin,twitter,facebook,email]"/>
            <pdf-export
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/pdf-export"
                downloadIconPath="/content/dam/guides/common-images/icons/manufacturing-export.svg"
                pdfPath="/content/dam/guides/common-images/pdfs/smart-security-latest.pdf"/>
            <copy-link-component
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/copy-link"
                copyLinkIcon="/content/dam/guides/common-images/icons/manufacturing-copy.svg"/>
            <theme-selector
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/theme-selector"
                darkTheme="/content/dam/guides/common-images/icons/manufacturing-dark-theme.svg"
                lightTheme="/content/dam/guides/common-images/icons/manufacturing-light-theme.svg"/>
            <accessibility
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/accessibility"
                textSizeIcon="/content/dam/guides/common-images/icons/text-size.svg"
                textSpaceIcon="/content/dam/guides/common-images/icons/letter-spacing.svg"
                highContrastIcon="/content/dam/guides/common-images/icons/high.svg"
                lowContrastIcon="/content/dam/guides/common-images/icons/low.svg"
                resetIcon="/content/dam/guides/common-images/icons/reset-btn.svg"
                accessibilityIcon="/content/dam/guides/common-images/icons/accessibility.svg"/>
        </toolbar>
    </jcr:content>
</jcr:root>
